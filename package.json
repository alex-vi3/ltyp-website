{
  "name": "ltyp-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "tinacms build && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .js,.ts,.astro",
    "lint:fix": "eslint . --ext .js,.ts,.astro --fix",
    "format": "prettier --write \"**/*.{js,ts,astro,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,astro,json,css,md}\""
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@fullcalendar/google-calendar": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tinacms/cli": "^4.0.2",
    "astro": "^7.3.8",
    "astro-icon": "^1.2.0",
    "astro-swiper": "^2.11.0",
    "fullcalendar": "^7.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "slate": "^0.114.0",
    "slate-dom": "^0.114.0",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.6",
    "tinacms": "^3.14.4"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@typescript-eslint/parser": "^8.71.2",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript-eslint": "^8.71.2"
  }
