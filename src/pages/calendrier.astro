---
import LayoutPages from '../layouts/LayoutPages.astro';
import backgroundImage from '../images/raquette3.webp';
---

<LayoutPages pageTitle="Calendrier" srcImage={backgroundImage.src} wide>
  <div class="flex flex-col gap-10">
    <div id="calendar" class="w-full bg-white rounded-md p-4 shadow-md"></div>
  </div>
</LayoutPages>

<script>
  import { Calendar } from 'fullcalendar';
  import type { CalendarOptions } from 'fullcalendar';
  import type { EventInput } from 'fullcalendar';
  import frLocale from 'fullcalendar/locales/fr';
  import dayGridPlugin from 'fullcalendar/daygrid';
  import timeGridPlugin from 'fullcalendar/timegrid';
  import listPlugin from 'fullcalendar/list';
  import themePlugin from 'fullcalendar/themes/classic';
  import googleCalendarPlugin from '@fullcalendar/google-calendar';
  import type { GoogleCalendarOptions } from '@fullcalendar/google-calendar';
  import 'fullcalendar/skeleton.css';
  import 'fullcalendar/themes/classic/theme.css';
  import 'fullcalendar/themes/classic/palette.css';

  // Couleur d'un événement selon le type déduit de son titre.
  const eventColors = [
    { match: 'match', color: '#b91c1c' }, // Rouge club
    { match: 'entraînement', color: '#000000' }, // Noir
    { match: 'animation', color: '#0b8043' }, // Noir
  ];

  const calendarEl = document.getElementById('calendar');

  if (calendarEl) {
    // En dessous de cette largeur (px), on affiche la vue planning (liste).
    const MOBILE_BREAKPOINT = 1024;
    const isMobile = () => window.innerWidth < MOBILE_BREAKPOINT;
    const getHeaderToolbar = () =>
      isMobile()
        ? { center: 'title' }
        : {
            start: 'prev,next today',
            center: 'title',
            end: 'dayGridMonth,timeGridWeek,listMonth',
          };
    const googleCalendarEvents = {
      googleCalendarId: 'ltyp@laposte.net',
    };

    const calendarOptions: CalendarOptions & GoogleCalendarOptions = {
      plugins: [
        themePlugin,
        dayGridPlugin,
        timeGridPlugin,
        listPlugin,
        googleCalendarPlugin,
      ],
      locale: frLocale,
      timeZone: 'Europe/Paris',
      initialView: isMobile() ? 'listMonth' : 'timeGridWeek',
      eventClass: 'calendar-event',
      eventTitleClass: 'calendar-event-title',
      firstDay: 1,
      nowIndicator: true,
      height: 'auto',
      headerToolbar: getHeaderToolbar(),
      slotMinTime: '08:00:00',
      slotMaxTime: '23:00:00',
      googleCalendarApiKey: import.meta.env.PUBLIC_GOOGLE_CALENDAR_API_KEY,
      events: googleCalendarEvents,
      eventDataTransform: (event: EventInput) => {
        const title = (event.title ?? '').trimStart().toLowerCase();
        const found = eventColors.find(({ match }) => title.startsWith(match));
        if (found) {
          event.color = found.color;
          event.contrastColor = '#ffffff';
        }
        return event;
      },
      eventDidMount: (info) => {
        const location = info.event.extendedProps.location;
        const titleEl = info.el.querySelector(
          '.calendar-event-title, .fc-event-title, .fc-list-event-title'
        );
        if (typeof location !== 'string' || !location.trim() || !titleEl)
          return;

        const normalizedLocation = location
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase();

        const commune = normalizedLocation.includes('yainville')
          ? 'Yainville'
          : normalizedLocation.includes('trait')
            ? 'Le Trait'
            : '';

        if (!commune) return;

        const locationEl = document.createElement('span');
        locationEl.className = 'calendar-event-location';
        locationEl.textContent = commune;
        titleEl.append(locationEl);
      },
    };

    const calendar = new Calendar(calendarEl, calendarOptions);

    calendar.render();

    window.addEventListener('resize', () => {
      const target = isMobile() ? 'listMonth' : 'timeGridWeek';
      if (calendar.view.type !== target) {
        calendar.changeView(target);
        calendar.setOption('headerToolbar', getHeaderToolbar());
      }
    });
  }
</script>

<style is:global>
  .calendar-event {
    border-radius: 4px;
  }

  .calendar-event .calendar-event-title {
    display: block;
    min-width: 0;
    overflow-wrap: anywhere;
    text-overflow: clip;
    white-space: normal;
  }

  .calendar-event-location {
    display: block;
    font-size: 0.8em;
    overflow-wrap: anywhere;
  }

  .calendar-event-title,
  .fc-event-title,
  .fc-list-event-title,
  .calendar-event-location {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
  }
</style>
